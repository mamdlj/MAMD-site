rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return signedIn() && userDoc().active == true; }
    function employee() { return activeUser() && userDoc().role == 'EMPLOYEE'; }
    function sameRestaurant(id) { return activeUser() && userDoc().restaurantId == id; }
    function ownerOrManager(id) { return sameRestaurant(id) && userDoc().role in ['SUPER_ADMIN','RESTAURANT_OWNER','MANAGER']; }

    match /roles/{roleId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || userDoc().role in ['SUPER_ADMIN','RESTAURANT_OWNER','MANAGER']);
      allow create: if false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.email == resource.data.email;
      allow delete: if activeUser() && userDoc().role in ['SUPER_ADMIN','RESTAURANT_OWNER'];
    }

    match /restaurants/{id} {
      allow read: if sameRestaurant(id);
      allow create: if signedIn() && userDoc().role in ['SUPER_ADMIN','RESTAURANT_OWNER'];
      allow update: if ownerOrManager(id);
      allow delete: if activeUser() && userDoc().role == 'SUPER_ADMIN';
    }

    match /products/{id} {
      allow read: if resource.data.available == true || (employee() && sameRestaurant(resource.data.restaurantId)) || ownerOrManager(resource.data.restaurantId);
      allow create: if ownerOrManager(request.resource.data.restaurantId);
      allow update, delete: if ownerOrManager(resource.data.restaurantId);
    }

    match /orders/{id} {
      allow create: if (employee() && sameRestaurant(request.resource.data.restaurantId)) || ownerOrManager(request.resource.data.restaurantId);
      allow read, update: if (employee() && sameRestaurant(resource.data.restaurantId)) || ownerOrManager(resource.data.restaurantId);
      allow delete: if ownerOrManager(resource.data.restaurantId);
    }

    match /inventory/{id} {
      allow read: if (employee() && sameRestaurant(resource.data.restaurantId)) || ownerOrManager(resource.data.restaurantId);
      allow create, update, delete: if ownerOrManager(resource.data.restaurantId);
    }

    match /employees/{id} {
      allow read: if (employee() && sameRestaurant(resource.data.restaurantId)) || ownerOrManager(resource.data.restaurantId);
      allow create, update, delete: if ownerOrManager(resource.data.restaurantId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}