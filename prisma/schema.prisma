generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { SUPER_ADMIN RESTAURANT_OWNER MANAGER INVENTORY_MANAGER KITCHEN_STAFF EMPLOYEE EDITOR }
enum OrderType { DINE_IN TAKEAWAY DELIVERY }
enum OrderStatus { PLACED CONFIRMED PREPARING READY DELIVERED CANCELLED }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }
enum Unit { KG G L ML PCS BOX PACK }
model Restaurant { id String @id @default(cuid()) name String slug String @unique slogan String? users User[] products Product[] employees Employee[] inventory InventoryItem[] orders Order[] createdAt DateTime @default(now()) }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String role Role @default(EMPLOYEE) restaurantId String? restaurant Restaurant? @relation(fields:[restaurantId],references:[id],onDelete:SetNull) employee Employee? orders Order[] createdAt DateTime @default(now()) }
model Employee { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) restaurantId String restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade) personnelCode String phone String? department String? position String? active Boolean @default(true) startDate DateTime @default(now()) @@unique([restaurantId,personnelCode]) }
model Product { id String @id @default(cuid()) restaurantId String restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade) name String slug String description String? price Decimal @db.Decimal(12,2) available Boolean @default(true) featured Boolean @default(false) orderItems OrderItem[] createdAt DateTime @default(now()) @@unique([restaurantId,slug]) }
model Order { id String @id @default(cuid()) number Int @default(autoincrement()) restaurantId String restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade) userId String? user User? @relation(fields:[userId],references:[id],onDelete:SetNull) type OrderType status OrderStatus @default(PLACED) customerName String? customerPhone String? tableNumber Int? notes String? subtotal Decimal @db.Decimal(12,2) discount Decimal @default(0) @db.Decimal(12,2) tax Decimal @default(0) @db.Decimal(12,2) serviceFee Decimal @default(0) @db.Decimal(12,2) total Decimal @db.Decimal(12,2) paymentStatus PaymentStatus @default(PENDING) transactionId String? items OrderItem[] createdAt DateTime @default(now()) @@index([restaurantId,status,createdAt]) }
model OrderItem { id String @id @default(cuid()) orderId String order Order @relation(fields:[orderId],references:[id],onDelete:Cascade) productId String product Product @relation(fields:[productId],references:[id],onDelete:Restrict) quantity Int unitPrice Decimal @db.Decimal(12,2) total Decimal @db.Decimal(12,2) }
model InventoryItem { id String @id @default(cuid()) restaurantId String restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade) name String code String quantity Decimal @db.Decimal(14,3) unit Unit @default(PCS) minimumStock Decimal @default(0) @db.Decimal(14,3) price Decimal @default(0) @db.Decimal(12,2) expiryDate DateTime? location String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([restaurantId,code]) }
